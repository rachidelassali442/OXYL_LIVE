{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "rules": [
    { "handle": "filesystem" }
  ],
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "/sitemap.xml" },
    { "source": "/whitepaper", "destination": "/whitepaper.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
